# true면 서버가 1초 간격의 KIS 형태 목 데이터를 생성합니다.
KIS_ENABLE_MOCK=true

# prod: 실전투자, vps: 모의투자
KIS_ENV=prod

# 서버에서만 읽으며 브라우저 번들에는 포함되지 않습니다.
KIS_APP_KEY=
KIS_APP_SECRET=

# /api/kis/status 호출용 긴 무작위 Bearer 토큰입니다.
KIS_STATUS_TOKEN=

# canonical, Open Graph, sitemap에 사용할 실제 공개 URL입니다.
NEXT_PUBLIC_SITE_URL=https://example.com

# SSE 보호 기본값입니다. 운영 규모에 맞춰 조정할 수 있습니다.
SSE_MAX_CONNECTIONS=500
SSE_MAX_GLOBAL_ATTEMPTS_PER_MINUTE=2000
SSE_MAX_CONNECTIONS_PER_IP=12
SSE_MAX_ATTEMPTS_PER_IP_PER_MINUTE=30

# 신뢰하는 호스팅 플랫폼이 전달 헤더를 실제 IP로 덮어쓸 때만 true로 설정합니다.
SSE_TRUST_PROXY_HEADERS=false
